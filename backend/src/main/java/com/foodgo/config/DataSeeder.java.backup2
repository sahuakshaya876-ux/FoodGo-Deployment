            System.out.println("Burgers added");
            System.out.println("Sandwiches added");
            System.out.println("Desserts added");
            System.out.println("Biryani Junction image updated");
            System.out.println("Missing food items automatically added");
            System.out.println("Owner password: FoodGo123");
            System.out.println("============================================================");
            System.out.println();
        };
    }


    // ================================================================
    // CREATE / UPDATE RESTAURANT + OWNER + FOOD ITEMS
    // ================================================================

    private void createRestaurant(
            String email,
            String restaurantName,
            String description,
            String cuisineType,
            String imageUrl,
            String address,
            String city,
            Double latitude,
            Double longitude,
            String password,
            UserRepository userRepository,
            RestaurantRepository restaurantRepository,
            FoodItemRepository foodItemRepository,
            FoodData[] foods) {


        // ============================================================
        // CREATE OWNER
        // ============================================================

        User owner = userRepository
                .findByEmail(email)
                .orElseGet(() -> {

                    User user = new User();

                    user.setFullName(restaurantName + " Owner");
                    user.setEmail(email);
                    user.setPassword(password);
                    user.setPhoneNumber("9000000000");
                    user.setRole(Role.ROLE_RESTAURANT_OWNER);
                    user.setEnabled(true);

                    return userRepository.save(user);
                });


        // ============================================================
        // CREATE OR FIND RESTAURANT
        // ============================================================

        Restaurant restaurant = restaurantRepository
                .findByOwner(owner)
                .orElseGet(() -> {

                    Restaurant r = new Restaurant();

                    r.setOwner(owner);

                    return r;
                });


        // ============================================================
        // ALWAYS UPDATE RESTAURANT DETAILS
        // ============================================================

        restaurant.setName(restaurantName);
        restaurant.setDescription(description);
        restaurant.setCuisineType(cuisineType);

        // This updates the restaurant image even if restaurant
        // already exists in MongoDB.
        restaurant.setImageUrl(imageUrl);

        restaurant.setAddress(address);
        restaurant.setCity(city);
        restaurant.setLatitude(latitude);
        restaurant.setLongitude(longitude);

        restaurant.setAverageRating(
                BigDecimal.valueOf(4.5)
        );

        restaurant.setTotalReviews(25);

        restaurant.setDeliveryFee(
                BigDecimal.valueOf(40)
        );

        restaurant.setEstimatedDeliveryMinutes(35);

        restaurant.setStatus(
                RestaurantStatus.APPROVED
        );

        restaurant.setOpen(true);

        restaurant = restaurantRepository.save(restaurant);


        // ============================================================
        // GET EXISTING FOOD ITEMS
        // ============================================================

        Set<String> existingFoodNames = new HashSet<>();

        foodItemRepository
                .findByRestaurant(restaurant)
                .forEach(item ->
                        existingFoodNames.add(
                                item.getName()
                                        .trim()
                                        .toLowerCase()
                        )
                );


        // ============================================================
        // ADD ONLY NEW FOOD ITEMS
        // ============================================================

        for (FoodData data : foods) {

            String foodName =
                    data.name.trim().toLowerCase();

            if (!existingFoodNames.contains(foodName)) {

                FoodItem item = new FoodItem();

                item.setRestaurant(restaurant);

                item.setName(data.name);

                item.setDescription(data.description);

                item.setPrice(
                        BigDecimal.valueOf(data.price)
                );

                item.setImageUrl(data.imageUrl);

                item.setVegetarian(data.vegetarian);

                item.setAvailable(true);

                item.setAverageRating(
                        BigDecimal.valueOf(4.5)
                );

                item.setTotalReviews(10);

                foodItemRepository.save(item);

                existingFoodNames.add(foodName);

                System.out.println(
                        "Added food: "
                                + data.name
                                + " -> "
                                + restaurantName
                );
            }
        }


        System.out.println(
                "Updated restaurant: "
                        + restaurantName
        );
    }


    // ================================================================
    // FOOD DATA HELPER
    // ================================================================

    private static FoodData food(
            String name,
            String description,
            double price,
            String imageUrl,
            boolean vegetarian) {

        /*
         * Use food-specific images instead of relying on manually supplied
         * URLs. This prevents unrelated images such as samosa images being
         * displayed for chicken items.
         */
        String image = getFoodImage(name);

        return new FoodData(
                name,
                description,
                price,
                image,
                vegetarian
        );
    }

    private static String getFoodImage(String name) {

        String n = name.toLowerCase().trim();

        // =========================
